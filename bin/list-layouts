#!/bin/bash
# List popular keyboard layouts with human-readable names.
#
# On Wayland/Hyprland setxkbmap does not reflect or set the real typing layout,
# so the "current" marker is derived from Hyprland via layouts-manager.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

CURRENT=""
if command -v hyprctl >/dev/null 2>&1; then
  ACTIVE_NAME="$("$SCRIPT_DIR/layouts-manager" get 2>/dev/null || true)"
  if [ -n "$ACTIVE_NAME" ]; then
    CURRENT="$("$SCRIPT_DIR/layout-names.sh" findcode "$ACTIVE_NAME" 2>/dev/null || true)"
  fi
fi
CURRENT="${CURRENT:-us}"

is_cur() { [ "$CURRENT" = "$1" ] && echo "true" || echo "false"; }

cat << EOF
[
  {"code": "us", "name": "English (US)", "current": $(is_cur us)},
  {"code": "gb", "name": "English (UK)", "current": $(is_cur gb)},
  {"code": "de", "name": "German", "current": $(is_cur de)},
  {"code": "fr", "name": "French", "current": $(is_cur fr)},
  {"code": "es", "name": "Spanish", "current": $(is_cur es)},
  {"code": "it", "name": "Italian", "current": $(is_cur it)},
  {"code": "pt", "name": "Portuguese", "current": $(is_cur pt)},
  {"code": "br", "name": "Portuguese (Brazil)", "current": $(is_cur br)},
  {"code": "nl", "name": "Dutch", "current": $(is_cur nl)},
  {"code": "be", "name": "Belgian", "current": $(is_cur be)},
  {"code": "ch", "name": "Swiss", "current": $(is_cur ch)},
  {"code": "se", "name": "Swedish", "current": $(is_cur se)},
  {"code": "no", "name": "Norwegian", "current": $(is_cur no)},
  {"code": "dk", "name": "Danish", "current": $(is_cur dk)},
  {"code": "fi", "name": "Finnish", "current": $(is_cur fi)},
  {"code": "ru", "name": "Russian", "current": $(is_cur ru)},
  {"code": "ua", "name": "Ukrainian", "current": $(is_cur ua)},
  {"code": "pl", "name": "Polish", "current": $(is_cur pl)},
  {"code": "cs", "name": "Czech", "current": $(is_cur cs)},
  {"code": "sk", "name": "Slovak", "current": $(is_cur sk)},
  {"code": "hu", "name": "Hungarian", "current": $(is_cur hu)},
  {"code": "ro", "name": "Romanian", "current": $(is_cur ro)},
  {"code": "bg", "name": "Bulgarian", "current": $(is_cur bg)},
  {"code": "hr", "name": "Croatian", "current": $(is_cur hr)},
  {"code": "sr", "name": "Serbian", "current": $(is_cur sr)},
  {"code": "sl", "name": "Slovenian", "current": $(is_cur sl)},
  {"code": "lt", "name": "Lithuanian", "current": $(is_cur lt)},
  {"code": "lv", "name": "Latvian", "current": $(is_cur lv)},
  {"code": "et", "name": "Estonian", "current": $(is_cur et)},
  {"code": "tr", "name": "Turkish", "current": $(is_cur tr)},
  {"code": "el", "name": "Greek", "current": $(is_cur el)},
  {"code": "ar", "name": "Arabic", "current": $(is_cur ar)},
  {"code": "fa", "name": "Persian", "current": $(is_cur fa)},
  {"code": "ja", "name": "Japanese", "current": $(is_cur ja)},
  {"code": "ko", "name": "Korean", "current": $(is_cur ko)},
  {"code": "zh", "name": "Chinese", "current": $(is_cur zh)},
  {"code": "hi", "name": "Indian", "current": $(is_cur hi)},
  {"code": "th", "name": "Thai", "current": $(is_cur th)},
  {"code": "vi", "name": "Vietnamese", "current": $(is_cur vi)}
]
EOF
