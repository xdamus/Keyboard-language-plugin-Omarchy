  {"code": "hr", "name": "Croatian", "current": $([ "$CURRENT" = "hr" ] && echo "true" || echo "false")},
  {"code": "rs", "name": "Serbian", "current": $([ "$CURRENT" = "rs" ] && echo "true" || echo "false")},
