  {"code": "in", "name": "Indian", "current": $([ "$CURRENT" = "in" ] && echo "true" || echo "false")},
  {"code": "ar", "name": "Arabic", "current": $([ "$CURRENT" = "ar" ] && echo "true" || echo "false")},
