#!/bin/bash
# List popular keyboard layouts with human-readable names

set -euo pipefail

# Check if setxkbmap is available
if ! command -v setxkbmap &>/dev/null; then
    echo '[]'
    exit 1
fi

# Get current layout
CURRENT=$(setxkbmap -query 2>/dev/null | grep "^layout:" | awk '{print $2}' || echo "us")

# Popular layouts with friendly names
cat << EOF
[
  {"code": "us", "name": "English (US)", "current": $([ "$CURRENT" = "us" ] && echo "true" || echo "false")},
  {"code": "gb", "name": "English (UK)", "current": $([ "$CURRENT" = "gb" ] && echo "true" || echo "false")},
  {"code": "de", "name": "German", "current": $([ "$CURRENT" = "de" ] && echo "true" || echo "false")},
  {"code": "fr", "name": "French", "current": $([ "$CURRENT" = "fr" ] && echo "true" || echo "false")},
  {"code": "es", "name": "Spanish", "current": $([ "$CURRENT" = "es" ] && echo "true" || echo "false")},
  {"code": "it", "name": "Italian", "current": $([ "$CURRENT" = "it" ] && echo "true" || echo "false")},
  {"code": "pt", "name": "Portuguese", "current": $([ "$CURRENT" = "pt" ] && echo "true" || echo "false")},
  {"code": "br", "name": "Portuguese (Brazil)", "current": $([ "$CURRENT" = "br" ] && echo "true" || echo "false")},
  {"code": "nl", "name": "Dutch", "current": $([ "$CURRENT" = "nl" ] && echo "true" || echo "false")},
  {"code": "be", "name": "Belgian", "current": $([ "$CURRENT" = "be" ] && echo "true" || echo "false")},
  {"code": "ch", "name": "Swiss", "current": $([ "$CURRENT" = "ch" ] && echo "true" || echo "false")},
  {"code": "se", "name": "Swedish", "current": $([ "$CURRENT" = "se" ] && echo "true" || echo "false")},
  {"code": "no", "name": "Norwegian", "current": $([ "$CURRENT" = "no" ] && echo "true" || echo "false")},
  {"code": "dk", "name": "Danish", "current": $([ "$CURRENT" = "dk" ] && echo "true" || echo "false")},
  {"code": "fi", "name": "Finnish", "current": $([ "$CURRENT" = "fi" ] && echo "true" || echo "false")},
  {"code": "ru", "name": "Russian", "current": $([ "$CURRENT" = "ru" ] && echo "true" || echo "false")},
  {"code": "ua", "name": "Ukrainian", "current": $([ "$CURRENT" = "ua" ] && echo "true" || echo "false")},
  {"code": "pl", "name": "Polish", "current": $([ "$CURRENT" = "pl" ] && echo "true" || echo "false")},
  {"code": "cz", "name": "Czech", "current": $([ "$CURRENT" = "cz" ] && echo "true" || echo "false")},
